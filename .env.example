# Database (matches docker-compose.yml)
DATABASE_URL="postgresql://admin:password@localhost:5432/hcms"

# First-run admin (created automatically when the database is empty)
AUTH_BOOTSTRAP_ADMIN_USERNAME="admin"
AUTH_BOOTSTRAP_ADMIN_PASSWORD="admin"
AUTH_BOOTSTRAP_ADMIN_DISPLAY_NAME="Admin"

# Primary AI — Azure OpenAI (gpt-5.4 deployment)
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/openai/v1"
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT="gpt-5.4"

# Backup AI (Google Gemini) — used when Azure primary fails
GEMINI_API_KEY=
# GEMINI_BACKUP_MODEL=gemini-2.0-flash
# GEMINI_SEO_FALLBACK_MODEL=gemini-1.5-flash

# Optional: standard OpenAI instead of Azure (only if Azure vars are unset)
# OPENAI_API_KEY=
