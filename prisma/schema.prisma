// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectStatus {
  Published
  Draft
  InReview
}

enum UserRole {
  admin
  editor
}

enum EmploymentType {
  FullTime
  PartTime
  Freelance
  Internship
  WorkingStudent
  Contract
}

enum RemoteType {
  OnSite
  Hybrid
  Remote
}

model User {
  id           String        @id @default(cuid())
  username     String        @unique
  displayName  String
  avatarUrl    String?
  passwordHash String
  role         UserRole      @default(editor)
  sessions     AuthSession[]
  activities   ActivityLog[]
  contentOpens ContentOpen[]
  jobs         Job[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  expiresAt DateTime
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([userId])
}

model Project {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  author        String        @default("Sarah")
  category      String        @default("Residential")
  status        ProjectStatus @default(Draft)
  description   String?
  excerpt       String?
  year          Int?
  period        String?
  location      String?
  client        String?
  architect     String?
  content       String?
  heroImageUrl  String?
  galleryUrls   String[]      @default([])
  technicalData Json?
  featured      Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model PortfolioItem {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  status       ProjectStatus @default(Draft)
  summary      String?
  /// TipTap HTML (same idea as BlogPost.content)
  content      String?
  websiteUrl   String?
  /// Cover / hero image (MediaImagePicker); public sites may map as coverImageUrl
  heroImageUrl String?
  galleryUrls  String[]      @default([])
  sortOrder    Int           @default(0)
  /// Variable meta rows: [{ "label": "Client", "value": "…" }, …]
  details      Json          @default("[]")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model TeamMember {
  id          String    @id @default(cuid())
  name        String
  role        String
  bio         String?
  avatarUrl   String?
  expertise   String[]  @default([])
  featured    Boolean   @default(false)
  sortOrder   Int       @default(0)
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Event {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  startsAt     DateTime
  endsAt       DateTime?
  location     String?
  description  String?
  content      String?
  heroImageUrl String?
  galleryUrls  String[]  @default([])
  published    Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BlogPost {
  id           String    @id @default(cuid())
  title        String
  slug         String    @unique
  excerpt      String?
  content      String?
  heroImageUrl String?
  galleryUrls  String[]  @default([])
  published    Boolean   @default(false)
  publishedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Job {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  position         String?
  department       String?
  location         String?
  employmentType   EmploymentType?
  remoteType       RemoteType?
  salary           String?
  applicationEmail String?
  applicationUrl   String?
  shortDescription String?
  content          String?
  requirements     String?
  benefits         String?
  responsibilities String?
  featured         Boolean         @default(false)
  published        Boolean         @default(false)
  publishedAt      DateTime?
  authorId         String?
  author           User?           @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([authorId])
  @@index([published])
  @@index([department])
}

model Property {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  address      String?
  status       String   @default("draft")
  priceEur     Int?
  bedrooms     Int?
  description  String?
  content      String?
  heroImageUrl String?
  galleryUrls  String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ActivityLog {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  title      String
  details    String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

model ContentOpen {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType String
  entityId   String
  openedAt   DateTime @default(now()) @updatedAt

  @@unique([userId, entityType, entityId])
  @@index([userId, openedAt])
  @@index([openedAt])
}

/// SEO metadata stored separately from primary content fields (polymorphic per collection).
model ContentSeo {
  id             String   @id @default(cuid())
  entityType     String
  entityId       String
  seoTitle       String   @default("")
  seoDescription String   @default("")
  seoKeywords    String[] @default([])
  seoImage       String   @default("")
  canonicalUrl   String   @default("")
  indexable      Boolean  @default(true)
  followLinks    Boolean  @default(true)
  aiGeneratedAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([entityType, entityId])
  @@index([entityType])
  @@index([entityId])
}

/// Static site pages (SEO-enabled collection).
model Page {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  body         String?       @db.Text
  excerpt      String?
  heroImageUrl String?
  status       ProjectStatus @default(Draft)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

/// Service offerings (SEO-enabled collection).
model Service {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  summary        String?
  heroImageUrl   String?
  introduction   String?       @db.Text
  sections       Json?
  ctaHeadline    String?
  ctaText        String?
  ctaButtonLabel String?
  ctaEmail       String?
  status         ProjectStatus @default(Draft)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

/// Tragwerker website — awards & recognition (website layer collection).
model Award {
  id           String   @id @default(cuid())
  title        String
  year         Int
  category     String
  description  String?  @db.Text
  organization String?
  projectName  String?
  sortOrder    Int      @default(0)
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([published, sortOrder])
}

/// Tragwerker website — publications (website layer collection).
model Publication {
  id          String   @id @default(cuid())
  title       String
  author      String
  year        Int
  publication String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([published, sortOrder])
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  sizeBytes    Int
  url          String
  title        String
  altText      String?
  tags         String[]
  folderId     String?
  folder       MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([folderId])
}

model MediaFolder {
  id         String        @id @default(cuid())
  name       String
  parentId   String?
  parent     MediaFolder?  @relation("MediaFolderTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   MediaFolder[] @relation("MediaFolderTree")
  assets     MediaAsset[]
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@index([parentId])
  @@unique([name, parentId])
}

/// Single Google Analytics connection for the workspace (OAuth + GA4 property).
model AnalyticsConnection {
  id                   String    @id @default(cuid())
  googleAccountEmail   String?
  propertyId           String?
  propertyDisplayName  String?
  /// AES-GCM encrypted refresh token
  refreshTokenEnc      String?
  accessTokenEnc       String?
  accessTokenExpiresAt DateTime?
  lastSyncAt           DateTime?
  lastBriefJson        String?
  lastBriefAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

/// Daily site-level totals for overview sparklines.
model AnalyticsDailyStat {
  id             String   @id @default(cuid())
  date           DateTime @db.Date
  sessions       Int      @default(0)
  users          Int      @default(0)
  pageviews      Int      @default(0)
  engagementRate Float    @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([date])
  @@index([date])
}

/// Per-path metrics for a reporting window (synced from GA4).
model AnalyticsPageStat {
  id               String   @id @default(cuid())
  path             String
  dateFrom         DateTime @db.Date
  dateTo           DateTime @db.Date
  pageviews        Int      @default(0)
  sessions         Int      @default(0)
  users            Int      @default(0)
  avgEngagementSec Float    @default(0)
  bounceRate       Float    @default(0)
  entrances        Int      @default(0)
  exits            Int      @default(0)
  entityType       String?
  entityId         String?
  entityTitle      String?
  pageviewsPrev    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([path, dateFrom, dateTo])
  @@index([entityType, entityId])
  @@index([pageviews])
}
